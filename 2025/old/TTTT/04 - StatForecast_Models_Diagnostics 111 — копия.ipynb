   "source": [
    "from utilsforecast.evaluation import evaluate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def cv_evaluation_with_forecasts(\n",
    "    df, \n",
    "    splits, \n",
    "    models, \n",
    "    model_names,\n",
    "    metrics,\n",
    "    refit=True,\n",
    "    freq=FREQ\n",
    "):\n",
    "    \"\"\"\n",
    "    Проводит кросс-валидацию с оценкой качества по КАЖДОМУ тестовому окну отдельно.\n",
    "    \n",
    "    Возвращает:\n",
    "        - eval_df: результаты оценки для каждого (uid, train_window, test_window)\n",
    "        - forecasts_df: все прогнозы с метаданными\n",
    "    \"\"\"\n",
    "    all_evals = []\n",
    "    all_forecasts = []\n",
    "    sf_cache = {}\n",
    "    \n",
    "    # Группируем сплиты по (unique_id, train_start, train_end)\n",
    "    for (uid, train_start, train_end), group in splits.groupby(['unique_id', 'train_start', 'train_end']):\n",
    "        # Обучение модели (один раз на всё окно обучения)\n",
    "        train = df[\n",
    "            (df['unique_id'] == uid) &\n",
    "            (df['ds'] >= train_start) &\n",
    "            (df['ds'] <= train_end)\n",
    "        ].copy()\n",
    "        \n",
    "        if len(train) == 0:\n",
    "            continue\n",
    "        \n",
    "        # Кэширование модели\n",
    "        cache_key = (uid, train_start, train_end)\n",
    "        if refit or cache_key not in sf_cache:\n",
    "            sf = StatsForecast(models=models, freq=freq)  # ← обучаем сразу все модели\n",
    "            sf.fit(train)\n",
    "            if not refit:\n",
    "                sf_cache[cache_key] = sf\n",
    "        else:\n",
    "            sf = sf_cache[cache_key]\n",
    "        \n",
    "        # Обработка КАЖДОГО тестового окна отдельно\n",
    "        for _, row in group.iterrows():\n",
    "            test = df[\n",
    "                (df['unique_id'] == uid) &\n",
    "                (df['ds'] >= row['test_start']) &\n",
    "                (df['ds'] <= row['test_end'])\n",
    "            ].copy()\n",
    "            \n",
    "            if len(test) == 0:\n",
    "                continue\n",
    "            \n",
    "            h = len(test)\n",
    "            # Прогноз на горизонт h\n",
    "            pred = sf.predict(h=h)\n",
    "            \n",
    "            # Фильтруем только нужные даты (защита от несоответствия частоты)\n",
    "            pred = pred[pred['ds'].isin(test['ds'])].set_index('ds').reindex(test['ds']).reset_index()\n",
    "            \n",
    "            # Сохраняем прогнозы\n",
    "            forecast_row = {'unique_id': uid}\n",
    "            for name in model_names:\n",
    "                forecast_row[name] = pred[name].values\n",
    "            forecast_row.update({\n",
    "                'ds': test['ds'].values,\n",
    "                'train_start': train_start,\n",
    "                'train_end': train_end,\n",
    "                'test_start': row['test_start'],\n",
    "                'test_end': row['test_end']\n",
    "            })\n",
    "            all_forecasts.append(pd.DataFrame(forecast_row))\n",
    "            \n",
    "            # Оценка качества ДЛЯ ЭТОГО ТЕСТОВОГО ОКНА\n",
    "            eval_input = test[['unique_id', 'ds', 'y']].copy()\n",
    "            for name in model_names:\n",
    "                eval_input[name] = pred[name].values\n",
    "            \n",
    "            eval_result = evaluate(\n",
    "                df=eval_input,\n",
    "                metrics=metrics,\n",
    "                train_df=train,\n",
    "                models=model_names  # ← явно указываем модели\n",
    "            )\n",
    "            # Добавляем метаданные сплита\n",
    "            eval_result['train_start'] = train_start\n",
    "            eval_result['train_end'] = train_end\n",
    "            eval_result['test_start'] = row['test_start']\n",
    "            eval_result['test_end'] = row['test_end']\n",
    "            all_evals.append(eval_result)\n",
    "    \n",
    "    eval_df = pd.concat(all_evals, ignore_index=True) if all_evals else pd.DataFrame()\n",
    "    forecasts_df = pd.concat(all_forecasts, ignore_index=True) if all_forecasts else pd.DataFrame()\n",
    "    \n",
    "    return eval_df, forecasts_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "eval_results, forecasts = cv_evaluation_with_forecasts(\n",
    "    df=panel_df,\n",
    "    splits=splits_slid2,\n",
    "    models=models,\n",
    "    model_names=model_names,\n",
    "    metrics=metrics,\n",
    "    refit=True\n",
    ")\n",
    "\n",
    "# Теперь работаем с eval_results (первый элемент кортежа)\n",
    "summary = eval_results.groupby(['metric','unique_id'])[model_names].agg(['mean', 'std'])\n",
    "summary.round(4)"
   ]
